rules_version = '2';
// Pravila pristupa za Kalorije. Kopiraj ceo fajl u Firebase konzolu:
// Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownsNew() { return request.resource.data.createdBy == request.auth.uid; }
    function ownsOld() { return resource.data.createdBy == request.auth.uid; }

    // Zajedničke namirnice i jela: svi prijavljeni čitaju i dodaju,
    // menja i briše samo onaj ko je napravio.
    match /namirnice/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && ownsNew();
      allow update: if signedIn() && ownsOld() && ownsNew();
      allow delete: if signedIn() && ownsOld();
    }
    match /jela/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && ownsNew();
      allow update: if signedIn() && ownsOld() && ownsNew();
      allow delete: if signedIn() && ownsOld();
    }

    // Lični podaci (profil i obroci): samo vlasnik.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /dani/{day} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
